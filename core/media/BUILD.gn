assert(is_mac)

# Fiber's integration with Chromium's media stack: macOS decodes H.264, HEVC
# and AAC, and Fiber builds no decoders of its own (see .agents/MEDIA.md).
# hooks/ holds the functions Fiber's media patches call.

# AAC through AudioToolbox. It's linked into //media (see
# patches/chromium/media-filters-BUILD.gn.patch), so it depends on nothing
# //media couldn't.
source_set("media") {
  sources = [
    "hooks/audio_toolbox_aac.cc",
    "hooks/audio_toolbox_aac.h",
  ]
  deps = [
    ":aac",
    "//base",
  ]
  frameworks = [ "AudioToolbox.framework" ]
  visibility = [ "//media/filters" ]
}

# H.264 and HEVC through VideoToolbox are in video_toolbox.gni.

# AAC for Web Audio's decodeAudioData, which decodes in the renderer, through
# AudioToolbox in the GPU process. It's linked into //content/renderer (see
# patches/chromium/content-renderer-BUILD.gn.patch).
source_set("web_audio") {
  sources = [
    "hooks/web_audio_decoder.cc",
    "hooks/web_audio_decoder.h",
    "web_audio/gpu_audio_decoder.cc",
    "web_audio/gpu_audio_decoder.h",
  ]
  deps = [
    "//base",
    "//media",
    "//media/mojo/clients",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
  ]
  visibility = [ "//content/renderer" ]
}

# AAC's AudioSpecificConfig, as AudioToolbox is given it: in the GPU process,
# and in the renderer, whose ffmpeg demuxes it (see
# patches/chromium/media-ffmpeg-BUILD.gn.patch).
source_set("aac") {
  sources = [
    "aac/audio_specific_config.cc",
    "aac/audio_specific_config.h",
  ]
  deps = [ "//base" ]
  visibility = [
    ":media",
    "//media/ffmpeg",
  ]
}
