# GN args every Fiber build needs. Each out dir's args.gn imports this before
# its own local settings (see scripts/build_chromium.sh).

# Product name, bundle ID, and company. The app bundle, helpers, and framework
# are named after PRODUCT_FULLNAME.
branding_file_path = "//fiber/branding/BRANDING"

# The app's LSMinimumSystemVersion and Fiber's Swift target (see
# //fiber/build:swift). Chromium's C++ keeps its own mac_deployment_target,
# since raising that would turn up deprecations all over Chromium.
mac_min_system_version = "26.0"

# Keep swiftc's module cache between builds, so an incremental build of
# //fiber/ui doesn't rebuild the SDK's modules (AppKit, SwiftUI…) every time.
swift_keep_intermediate_files = true

# Chromium's default features, as it ships them. Otherwise builds that aren't
# Chrome-branded turn on testing/variations/fieldtrial_testing_config.json's
# experiments: dozens of in-progress Google features (Lens, AI Mode, Gemini).
disable_fieldtrial_testing_config = true

# H.264, AAC and MP4, decoded by macOS: much of the web's video is only served
# as those. Chromium's build of ffmpeg has no H.264 or AAC decoder, and nothing
# else here brings one (see .agents/MEDIA.md).
proprietary_codecs = true
ffmpeg_branding = "Chromium"
media_use_openh264 = false
enable_ffmpeg_video_decoders = false

enable_swiftshader = false
enable_swiftshader_vulkan = false
angle_enable_swiftshader = false
angle_enable_vulkan = false
dawn_use_swiftshader = false

# The test locales (en-XA, ar-XB), which official builds leave out.
enable_pseudolocales = false
