import("//build/config/sysroot.gni")

assert(is_mac)

# Flags for Fiber's Swift modules (see swift.gni), with the SDK the rest of the
# build uses. Chromium's toolchain runs Xcode's swiftc.
config("swift") {
  if (current_cpu == "arm64") {
    _arch = "arm64"
  } else {
    _arch = "x86_64"
  }
  swiftflags = [
    "-target",
    "$_arch-apple-macos$mac_min_system_version",
    "-sdk",
    rebase_path(sysroot, root_build_dir),
    "-swift-version",
    "6",
  ]
  if (!is_debug) {
    swiftflags += [ "-O" ]
  }
}

# For everything that links Swift code: the linker rejects objects built for a
# newer macOS than the image, so those images target macOS 26 too. This comes
# after Chromium's own -mmacos-version-min, and the last one wins.
config("swift_link") {
  ldflags = [
    "-mmacos-version-min=$mac_min_system_version",

    # SwiftUI's imports ask to link CoreAudioTypes, which is headers only, and
    # Chromium's --strict-auto-link makes the missing binary an error.
    "-Wl,--ignore-auto-link-option=CoreAudioTypes",
  ]

  # The Swift runtime ships with macOS; the SDK has its link stubs.
  lib_dirs = [ "$sysroot/usr/lib/swift" ]
}
