import("//build/apple/tweak_info_plist.gni")
import("//chrome/version.gni")

# Fiber's version (VERSION), and what the app shows: that, then the Chromium
# release without its MINOR (always 0), as in 0.1.0c155.8059.12. Chrome keeps
# Chromium's version, which the User-Agent, extensions and profiles rely on.
fiber_version = read_file("//fiber/branding/VERSION", "trim string")
fiber_version_full = "${fiber_version}c$chrome_version_major." +
                     "$chrome_version_build.$chrome_version_patch"

# tweak_info_plist's Info.plist, with Fiber's version in place of Chromium's.
# Only the app's uses it (patches/chromium/chrome-BUILD.gn.patch); the
# framework and helpers keep Chromium's, which is what Chrome's code reads.
template("fiber_app_info_plist") {
  _chromium_plist_target = target_name + "_chromium"
  tweak_info_plist(_chromium_plist_target) {
    forward_variables_from(invoker, "*")
  }

  action(target_name) {
    script = "//fiber/branding/set_version.py"
    sources = get_target_outputs(":$_chromium_plist_target")
    outputs = [ "$target_gen_dir/${target_name}_fiber.plist" ]
    deps = [ ":$_chromium_plist_target" ]
    args = [
      "--version",
      fiber_version,
      "--version-full",
      fiber_version_full,
      rebase_path(sources[0], root_build_dir),
      rebase_path(outputs[0], root_build_dir),
    ]
  }
}
