import("//build/buildflag_header.gni")
import("//build/config/mac/mac_sdk.gni")
import("//fiber/branding/version.gni")

assert(is_mac)

# Fiber's app icon and document badge, as the Assets.car and app.icns the app
# and its alert helpers bundle in place of Chromium's (see
# patches/chromium/chrome-BUILD.gn.patch). icon/build.py generates the inputs.
action("app_icon") {
  script = "compile_icon.py"
  inputs = [
    "icon/AppIcon.icon/icon.json",
    "icon/Assets.xcassets/Contents.json",
  ]
  outputs = [
    "$target_gen_dir/Assets.car",
    "$target_gen_dir/app.icns",
  ]

  # Lists every file in the two packages, which icon/build.py may rename.
  depfile = "$target_gen_dir/app_icon.d"
  args = [
    "--output-dir",
    rebase_path(target_gen_dir, root_build_dir),
    "--minimum-deployment-target",
    mac_min_system_version,
    "--depfile",
    rebase_path(depfile, root_build_dir),
    rebase_path("icon/AppIcon.icon", root_build_dir),
    rebase_path("icon/Assets.xcassets", root_build_dir),
  ]
}

# Fiber's scheme for Chrome's pages, for url_formatter and the omnibox (see
# url_scheme.h).
source_set("url_scheme") {
  sources = [ "url_scheme.h" ]
}

# The version the app shows (see version.gni), as a UTF-16 literal for
# Chrome's About pages.
buildflag_header("version_buildflags") {
  header = "version_buildflags.h"
  flags = [ "FIBER_VERSION_FULL=u\"$fiber_version_full\"" ]
}
