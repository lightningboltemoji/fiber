import("//fiber/build/swift.gni")

# Everything the user sees, in Swift. It talks to //fiber/browser only through
# //fiber/bridge. Package.swift builds the same sources with SwiftPM, along
# with the FiberUIHarness app.
fiber_swift_source_set("ui") {
  module_name = "FiberUI"
  sources = [
    "Sources/FiberUI/BrowserWindowController.swift",
    "Sources/FiberUI/CommandPalette.swift",
    "Sources/FiberUI/ContextMenu.swift",
    "Sources/FiberUI/DownloadsWait.swift",
    "Sources/FiberUI/Extensions.swift",
    "Sources/FiberUI/ExtensionsMenu.swift",
    "Sources/FiberUI/FiberMark.swift",
    "Sources/FiberUI/HistorySwipe.swift",
    "Sources/FiberUI/JavaScriptDialog.swift",
    "Sources/FiberUI/LoadProgressBar.swift",
    "Sources/FiberUI/NewTabView.swift",
    "Sources/FiberUI/OutsetShadowView.swift",
    "Sources/FiberUI/PageState.swift",
    "Sources/FiberUI/Prompt.swift",
    "Sources/FiberUI/QuitConfirmation.swift",
    "Sources/FiberUI/RimmedGlassView.swift",
    "Sources/FiberUI/StatusBubble.swift",
    "Sources/FiberUI/Suggestion.swift",
    "Sources/FiberUI/SuggestionList.swift",
    "Sources/FiberUI/TabList.swift",
    "Sources/FiberUI/TabPicker.swift",
    "Sources/FiberUI/TabPickerView.swift",
    "Sources/FiberUI/TabSidebar.swift",
    "Sources/FiberUI/TabState.swift",
    "Sources/FiberUI/Toolbar.swift",
    "Sources/FiberUI/Veil.swift",
    "Sources/FiberUI/VeilPrompt.swift",
    "Sources/FiberUI/WindowDragArea.swift",
    "Sources/FiberUI/WindowFrame.swift",
  ]
  deps = [ "//fiber/bridge" ]
  frameworks = [
    "AppKit.framework",
    "SwiftUI.framework",
  ]
}
