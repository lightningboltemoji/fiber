assert(is_mac)

# Fiber's integration with Blink, in the renderer. It's linked into Blink's
# core (see patches/chromium/third_party-blink-renderer-core-BUILD.gn.patch),
# so it depends on nothing Blink couldn't.
source_set("renderer") {
  sources = [
    "hooks/page_scrollbar.cc",
    "hooks/page_scrollbar.h",
  ]
  deps = [ "//base" ]
  public_deps = [ "//ui/gfx/geometry" ]
  visibility = [ "//third_party/blink/renderer/core" ]
}
