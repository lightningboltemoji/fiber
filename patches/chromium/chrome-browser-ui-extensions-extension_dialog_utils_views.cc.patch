 #include "chrome/browser/ui/views/extensions/extensions_container_views.h"
 #include "chrome/browser/ui/views/frame/browser_view.h"
 #include "chrome/browser/ui/views/frame/toolbar_button_provider.h"
+#include "build/build_config.h"
 #include "components/constrained_window/constrained_window_views.h"
+#include "fiber/browser/hooks/browser_window_factory.h"
+#include "fiber/browser/hooks/dialog_models.h"
 #include "ui/views/bubble/bubble_dialog_delegate_view.h"
 #include "ui/views/bubble/bubble_dialog_model_host.h"
 #include "ui/views/widget/widget.h"
@@ -40,11 +43,25 @@ void ShowDialog(gfx::NativeWindow parent,
 
 void ShowModalDialog(gfx::NativeWindow parent,
                      std::unique_ptr<ui::DialogModel> dialog_model) {
+#if BUILDFLAG(IS_MAC)
+  // Fiber: Fiber windows can't host views dialogs; Fiber asks instead.
+  if (fiber::IsFiberWindow(parent)) {
+    fiber::ShowWindowModalDialog(std::move(dialog_model), parent);
+    return;
+  }
+#endif
   constrained_window::ShowBrowserModal(std::move(dialog_model), parent);
 }
 
 void ShowWebModalDialog(content::WebContents* web_contents,
                         std::unique_ptr<ui::DialogModel> dialog_model) {
+#if BUILDFLAG(IS_MAC)
+  // Fiber: Fiber windows can't host views dialogs; Fiber asks instead.
+  if (fiber::IsInFiberWindow(web_contents)) {
+    fiber::ShowTabModalDialog(std::move(dialog_model), web_contents);
+    return;
+  }
+#endif
   constrained_window::ShowWebModal(std::move(dialog_model), web_contents);
 }
 
